# Publish only what the site uses; everything else stays local.
/*
!/.gitignore
!/index.html
!/css/
!/js/
!/images/
!/videos/

/images/*
!/images/books/
!/images/illustrations/
!/images/logo/
!/images/photos/
!/images/decorations/
!/images/tiles/

/images/books/book-ome-danpung.jpeg
/images/illustrations/*
!/images/illustrations/hero-video-poster.jpg
!/images/illustrations/author-kim-eunjeong.png
/images/logo/logo-tree-wordmark.png
/images/photos/bookstore-interior.png
/images/photos/sempe-exhibition-poster.png
/images/decorations/
/images/tiles/*.png
